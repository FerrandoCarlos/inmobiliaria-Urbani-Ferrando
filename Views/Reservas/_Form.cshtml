@model InmobiliariaApp.Models.Reserva
@{
    var inquilinos = (IList<InmobiliariaApp.Models.Inquilino>)ViewBag.Inquilinos;
    var inmuebles = (IList<InmobiliariaApp.Models.Inmueble>)ViewBag.Inmuebles;
    var fechaHoy = DateTime.Now.ToString("yyyy-MM-dd");
}
<form id="formReserva">
    @Html.AntiForgeryToken()
    <input type="hidden" value="@Model.Id" name="Id" id="Id">

    <div class="mb-3">
        <label for="InquilinoId" class="form-label">Inquilino</label>
        <div class="buscador-wrapper">
            <input type="text" class="form-control" id="InquilinoBuscar"
                   placeholder="Buscar por nombre, apellido o DNI..." autocomplete="off" required />
            <input type="hidden" id="InquilinoId" name="InquilinoId" value="@Model.InquilinoId" />
            <div id="InquilinoResultados" class="buscador-resultados d-none"></div>
        </div>

        <span class="text-danger" id="error-inquilinoId"></span>
    </div>

    <div class="mb-3">
        <label for="InmuebleId" class="form-label">Inmueble</label>
        <div class="buscador-wrapper">
            <input type="text" class="form-control" id="InmuebleBuscar" placeholder="Buscar por dirección..."
                   autocomplete="off" required />
            <input type="hidden" id="InmuebleId" name="InmuebleId" value="@Model.InmuebleId" />
            <div id="InmuebleResultados" class="buscador-resultados d-none"></div>
        </div>
        <span class="text-danger" id="error-inmuebleId"></span>
    </div>

    <div class="mb-3">
        <label for="FechaDesde" class="form-label">Fecha desde</label>
        <input type="date" class="form-control" id="FechaDesde" name="FechaDesde"
               value="@(Model.FechaDesde != DateTime.MinValue ? Model.FechaDesde.ToString("yyyy-MM-dd") : "")"
               min="@fechaHoy" required />
        <span class="text-danger" id="error-FechaDesde"></span>
    </div>

    <div class="mb-3">
        <label for="FechaHasta" class="form-label">Fecha hasta</label>
        <input type="date" class="form-control" id="FechaHasta" name="FechaHasta"
               value="@(Model.FechaHasta != DateTime.MinValue ? Model.FechaHasta.ToString("yyyy-MM-dd") : "")" required />
        <span class="text-danger" id="error-FechaHasta"></span>
    </div>

    <div id="mensajeGeneral" class="alert alert-danger d-none"></div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

<script src="~/js/buscador-select.js"></script>

<script>
    inicializarBuscadorSelect({
        inputTextoId: 'InquilinoBuscar',
        inputHiddenId: 'InquilinoId',
        endpoint: '/Inquilinos/Buscar',
        resultadosId: 'InquilinoResultados',
        @if (Model.Id != 0 && Model.Inquilino != null)
        {
            @:valorInicialTexto: '@Model.Inquilino.Apellido, @Model.Inquilino.Nombre (DNI @Model.Inquilino.Dni)',
        }
    });

    inicializarBuscadorSelect({
        inputTextoId: 'InmuebleBuscar',
        inputHiddenId: 'InmuebleId',
        endpoint: '/Inmuebles/Buscar',
        resultadosId: 'InmuebleResultados',
        @if (Model.Id != 0 && Model.Inmueble != null)
        {
            @:valorInicialTexto: '@Model.Inmueble.Direccion',
        }
    });
</script>
