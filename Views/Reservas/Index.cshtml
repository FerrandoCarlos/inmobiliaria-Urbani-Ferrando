@model IList<InmobiliariaApp.Models.Reserva>
@{
    ViewData["Title"] = "Reservas";
    int paginaNro = ViewBag.PaginaNro ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    var filtro = (ViewBag.FiltroActual as ReservaFiltro) ?? new ReservaFiltro();
}

<div class="page-header">
    <h1>Reservas</h1>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Búsqueda y Filtro de Reservas</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Reservas" asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Fecha Desde</label>
                    <input type="date" name="FechaDesde" class="form-control" 
                           value="@(filtro.FechaDesde?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Fecha Hasta</label>
                    <input type="date" name="FechaHasta" class="form-control" 
                           value="@(filtro.FechaHasta?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Finalizan en (días)</label>
                    <input type="number" name="FinalizanEnDias" class="form-control" 
                           placeholder="Ej: 7, 15, 30" min="1" value="@filtro.FinalizanEnDias" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<form style="display:none">@Html.AntiForgeryToken()</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div id="alertContainer"></div>

<div class="table-panel">
    <p class="d-flex gap-2 align-items-center">
        <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
    </p>

    <table class="table table-striped" id="tablaReservas">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th class="estado-reserva">Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reserva in Model)
            {
                <tr id="fila-@reserva.Id">
                    <td>@reserva.Inquilino?.Apellido, @reserva.Inquilino?.Nombre</td>
                    <td>@reserva.Inmueble?.Direccion</td>
                    <td>@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td class="estado-reserva">
                        <span class="badge @(reserva.Estado == "Vigente" ? "bg-success" : "bg-secondary")">
                            @reserva.Estado
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@reserva.Id"
                           class="btn btn-sm btn-outline-secondary">Detalles</a>
                        @if (reserva.Estado == "Vigente")
                        {
                            <a asp-action="Edit" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Create" asp-route-reservaOriginalId="@reserva.Id"
                               class="btn btn-sm btn-outline-secondary btn-extender">
                                Extender
                            </a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" data-id="@reserva.Id">
                                    Eliminar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-finalizar"
                                        onclick="finalizarReserva(@reserva.Id)">
                                    Finalizar
                                </button>
                            }
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@reserva.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" data-id="@reserva.Id">
                                    Eliminar
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p>No hay reservas cargadas.</p>
    }

    @if (totalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaNro ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-paginaNro="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@await Html.PartialAsync("_ModalConfirmarBaja")

@section Scripts {
    <script src="~/js/abm-reserva.js"></script>
    <script>inicializarBotonesEliminarReserva();</script>
}
