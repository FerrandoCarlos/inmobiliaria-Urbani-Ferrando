@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="blueprint-card error-card">
    <span class="eyebrow error-eyebrow">Ocurrió un problema</span>
    <h1 class="error-title">Algo no salió como esperábamos</h1>
    <p class="error-text">
        Se produjo un error al procesar tu solicitud. Podés volver al inicio e intentar nuevamente.
    </p>
</div>

@if (Model.ShowRequestId)
{
    <p class="error-text error-request-id">
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2"> Volver al inicio</a>
