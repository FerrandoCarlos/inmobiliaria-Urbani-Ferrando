@model IList<InmobiliariaApp.Models.Inquilino>
@{
    ViewData[index: "Title"] = "Inquilinos";
    int paginaNro = ViewBag.PaginaNro ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1>
    Inquilinos
</h1>
<form style="display:none">@Html.AntiForgeryToken()</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div id="alertContainer"></div>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Inquilino</a>
</p>

<table class="table table-striped" id="tablaInquilinos">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Apellido</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inquilino in Model)
        {
            <tr id="fila-@inquilino.Id">
                <td>@inquilino.Dni</td>
                <td>@inquilino.Apellido</td>
                <td>@inquilino.Nombre</td>
                <td>@inquilino.Telefono</td>
                <td>@inquilino.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@inquilino.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" data-id="@inquilino.Id">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any())
{
    <p>No hay inquilinos cargados.</p>
}

@if (totalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaNro ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-paginaNro="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/abm-persona.js"></script>
    <script>inicializarAbmPersona("Inquilinos");</script>
}
