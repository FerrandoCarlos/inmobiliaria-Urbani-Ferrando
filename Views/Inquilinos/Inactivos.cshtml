@model IList<InmobiliariaApp.Models.Inquilino>
@{
    ViewData["Title"] = "Inquilinos Inactivos";
}

<div class="page_header">
    <h1>Inquilinos Inactivos</h1>
</div>

<form style="display: none;">@Html.AntiForgeryToken()</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-panel">
    <p class="mb-3">
        <a asp-action="Index" class="btn btn-secondary">Volver a Inquilinos</a>
    </p>

    <table class="table table-striped" id="tablaInactivo">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Apellido</th>
                <th>Nombre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inquilino in Model)
            {
                <tr id="fila-@inquilino.Id">
                    <td>@inquilino.Dni</td>
                    <td>@inquilino.Apellido</td>
                    <td>@inquilino.Nombre</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-reactivar" data-id='@inquilino.Id'>
                            Reactivar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="mt-3">No hay inquilinos inactivos.</p>
    }
</div>

@section Scripts {
    <script src="~/js/abm-persona.js"></script>
    <script>inicializarBotonesReactivar("Inquilinos");</script>
}
