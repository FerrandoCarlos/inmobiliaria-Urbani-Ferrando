@{
    ViewData["Title"] = "Inicio";
}

<div class="hero">
    <span class="eyebrow">Gestión Inmobiliaria</span>
    <h1>Un registro claro de cada propietario y de cada inquilino</h1>
    <p>
        Cargá, editá y dá de baja los datos de propietarios e inquilinos
        desde un mismo lugar, con la información siempre a mano para
        cuando la necesites
    </p>

    <div class="hero-stats">
        <div>
            <span class="stats-value">@ViewBag.CantidadPropietarios</span>
            <span class="stats-label">Propietarios activos</span>
        </div>
        <div>
            <span class="stats-value">@ViewBag.CantidadInquilinos</span>
            <span class="stats-label">Inquilinos activos</span>
        </div>
    </div>
    <div class="quick-access-grid">
        <div class="blueprint-card quick-access-card">
            <i class="bi bi-building quick-access-icon"></i>
            <h3>Propietarios</h3>
            <p>Gestiona los datos de cada propietario.</p>
            <a asp-controller="Propietarios" asp-action="Index" class="btn btn-secondary"> Ir a Propietarios</a>
        </div>
        <div class="blueprint-card quick-access-card">
            <i class="bi bi-people-fill quick-access-icon"></i>
            <h3>Inquilinos</h3>
            <p>Gestiona los datos de cada Inquilino.</p>
            <a asp-controller="Inquilinos" asp-action="Index" class="btn btn-secondary">Ir a Inquilinos</a>
        </div>
        <div class="blueprint-card quick-access-card">
            <i class="bi bi-people-fill quick-access-icon"></i>
            <h3>Inmuebles</h3>
            <p>Gestiona los datos de cada Inmueble.</p>
            <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-secondary">Ir a Inmuebles</a>
        </div>
    </div>
