@{
    ViewData["Title"] = "Inicio";
}

<div class="hero">
    <span class="eyebrow">Gestión Inmobiliaria</span>
    <h1>Un registro claro de cada propietario y de cada inquilino</h1>
    <p>
        Cargá, editá y dá de baja los datos de propietarios e inquilinos
        desde un mismo lugar, con la información siempre a mano para
        cuando la necesites
    </p>

    <div class="hero-stats">
        <div>
            <span class="stat-value">@ViewBag.CantidadPropietarios</span>
            <span class="stat-label">Propietarios activos</span>
        </div>
        <div>
            <span class="stat-value">@ViewBag.CantidadInquilinos</span>
            <span class="stat-label">Inquilinos activos</span>
        </div>
    </div>
</div>
