@using InmobiliariaApp.Models
@model InmobiliariaApp.Models.Inmueble
@{
    ViewData["Title"] = "Inmueble - Imágenes";
    var Id = Model?.Id ?? 0;
}
<h1>Fotos del Inmueble: @Model?.Direccion</h1>
<hr />
<div class="container mt-5">
    <div class="row">
        <!-- Foto de Portada -->
        <div class="col-md-6">
            <h4>Foto de Portada</h4>

            @if (!string.IsNullOrEmpty(Model?.ImgPortadaURL))
            {
                <div class="mb-3">
                    <label>Portada actual:</label><br />
                    <img src="@Model.ImgPortadaURL?v=@DateTime.Now.Ticks" class="img-thumbnail" style="max-width: 100%;" />
                    <form asp-controller="Inmuebles" asp-action="ImgPortadaURL" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="InmuebleId" value="@Id" />
                        <button type="submit" class="btn btn-danger btn-sm mt-2">
                            <i class="bi bi-trash-fill"></i> Eliminar Portada
                        </button>
                    </form>
                </div>
            }
            <form asp-controller="Inmuebles" asp-action="ImgPortadaURL" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="Archivo">Seleccionar imagen</label>
                    <input type="file" class="form-control-file" id="Archivo" name="Archivo" accept="image/*" required>
                    <input type="hidden" name="InmuebleId" value="@Id" />
                </div>
                <button type="submit" class="btn btn-primary mt-2"><i class="bi bi-arrow-bar-up"></i></i> Subir Portada</button>
            </form>
        </div>

        <!-- Imágenes del Interior -->
        <div class="col-md-6">
            <h4>Imágenes del Interior</h4>
            <div class="mb-3">
                <label>Imágenes actuales:</label>
                <div class="d-flex flex-wrap" id="galeriaActual">
                    @if (Model?.Imagenes?.Count > 0)
                    {
                        foreach (var imagen in Model.Imagenes)
                        {
                            <div class="m-2 position-relative imagen-con-hover">
                                <img src="@imagen.ImgURL" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                                <button type="button" class="btn btn-danger btn-sm btn-eliminar-imagen"
                                        onclick="eliminarImagen(@imagen.Id)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p>No hay imágenes interiores disponibles.</p>
                    }
                </div>
            </div>
            <form id="formInterior" enctype="multipart/form-data" onsubmit="subirImagenes(event)">
                <div class="form-group">
                    <label for="imagenes">Seleccionar imágenes</label>
                    <input type="file" class="form-control-file" id="imagenes" name="imagenes"
                           onchange="previsualizar(event)" accept="image/*" multiple required>
                </div>
                <button type="submit" class="btn btn-success mt-2"><i class="bi bi-arrow-bar-up"></i></i> Subir</button>
            </form>

            <div class="mt-3">
                <h6>Previsualización:</h6>
                <div id="preview" class="d-flex flex-wrap"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const idInmueble = @Id;

        function previsualizar(event) {
            $('#preview').empty();
            const files = event.target.files;
            if (!files) return;
            [...files].forEach(file => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#preview').append(`
                            <div class="m-2">
                                <img src="${e.target.result}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                            </div>`);
                };
                reader.readAsDataURL(file);
            });
        }

        function subirImagenes(event) {
            event.preventDefault();
            const files = document.querySelector('#imagenes').files;
            if (files.length === 0) {
                if (window.notyf) notyf.error("Selecciona al menos una imagen");
                return;
            }

            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('ImagenesInmueble', files[i]);
            }

            $.ajax({
                url: `/ImagenesInmueble/Alta/${idInmueble}`,
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
            }).done(function (imagenes) {
                if (window.notyf) notyf.success('Imágenes subidas con éxito');
                mostrarImagenes(imagenes);
            }).fail(function (xhr) {
                const mensaje = xhr.responseText || 'Error al subir las imágenes';
                if (window.notyf) notyf.error(mensaje);
            }).always(function () {
                document.getElementById('formInterior').reset();
                $('#preview').empty();
            });
        }

        function eliminarImagen(imagenId) {
            $.post(`/ImagenesInmueble/Eliminar/${imagenId}`)
                .done(function (imagenes) {
                    if (window.notyf) notyf.success('Imagen eliminada');
                    mostrarImagenes(imagenes);
                })
                .fail(function (xhr) {
                    const mensaje = xhr.responseText || 'Error al eliminar la imagen';
                    if (window.notyf) notyf.error(mensaje);
                });
        }

        function mostrarImagenes(imagenes) {
            if (imagenes && imagenes.length > 0) {
                let html = ``;
                imagenes.forEach(img => {
                    const url = img.imgUrl || img.imgURL || img.ImgURL || img.url;
                    const imgId = img.id || img.Id;

                    html += `
                        <div class="m-2 position-relative imagen-con-hover">
                            <img src="${url}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                            <button type="button" class="btn btn-danger btn-sm btn-eliminar-imagen" onclick="eliminarImagen(${imgId})">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        `;
                });
                $('#galeriaActual').html(html);
            } else {
                $('#galeriaActual').html('<p>No hay imágenes interiores disponibles.</p>');
            }
        }
    </script>
}