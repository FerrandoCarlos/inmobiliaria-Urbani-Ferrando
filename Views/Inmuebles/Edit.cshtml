@model InmobiliariaApp.Models.Inmueble
@{
    ViewData["Title"] = "Editar Inmueble";
}
<div class="form-panel">
    <div class="form-panel-header is-edit">
        <h2>Editar Inmueble</h2>
    </div>
    <div class="form-panel-body">
        @await Html.PartialAsync("_Form", Model)
    </div>
    @{
        var lat = Model.Latitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = Model.Longitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
    <div class="mb-3">
        <label class="form-label fw-bold">Ubicación exacta:</label>
        <div class="ratio ratio-16x9 rounded shadow-sm">
            <iframe id="mapaGoogle" src="https://www.google.com/maps?q=@lat,@lng&z=16&output=embed" width="100%"
                    height="350" style="border:0;" allowfullscreen="" loading="lazy">
            </iframe>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/abm-inmueble.js"></script>
    <script>inicializarAbmInmueble("Inmuebles");</script>
}
