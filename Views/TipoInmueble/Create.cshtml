@model InmobiliariaApp.Models.TipoInmueble
@{
    ViewData[index: "Title"] = "Editar Tipo de Inmueble";
}

<div class="form-panel">
    <div class="form-panel-header is-create">
        <h2>Nuevo Tipo de inmueble</h2>
    </div>
    <div class="form-panel-body">
        @await Html.PartialAsync("_Form", Model ?? new InmobiliariaApp.Models.TipoInmueble())
    </div>
</div>

@section Scripts {
    <script src="~/js/abm-tipoinmueble.js"></script>
    <script> inicializarAbmTipoInmueble(); </script>
}